{
  "manifest_version": 3,
  "name": "Bliss Pharmex - IndiaMART AI Lead Auto-Buyer",
  "version": "3.0.0",
  "description": "Pre-Render Zero-Latency AI Sniper for IndiaMART BuyLeads. Buys leads before DOM renders with direct session API.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*.indiamart.com/*",
    "http://*.indiamart.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bliss Lead Auto-Buyer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.indiamart.com/*",
        "http://*.indiamart.com/*"
      ],
      "js": [
        "injected_main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.indiamart.com/*",
        "http://*.indiamart.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
