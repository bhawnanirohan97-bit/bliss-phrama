{
  "manifest_version": 3,
  "name": "Bliss Pharmex - IndiaMART AI Lead Auto-Buyer",
  "version": "1.0.0",
  "description": "AI-powered auto-buyer for IndiaMART BuyLeads. Filters domestic Indian leads, checks target export countries, and auto-buys matching pharma leads.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://seller.indiamart.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bliss Lead Auto-Buyer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://seller.indiamart.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
